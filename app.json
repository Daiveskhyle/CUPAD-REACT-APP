{
  "expo": {
    "name": "CUPAD",
    "slug": "cupad-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/cupad logo.png",
    "scheme": "cupad",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "staff.app.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/cupad logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "staff.app.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/cupad logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/cupad logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://cupadapp.name.ng/api",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3ba8ee8d-359f-445e-9540-838997682312"
      }
    },
    "owner": "cupad"
  }
}
